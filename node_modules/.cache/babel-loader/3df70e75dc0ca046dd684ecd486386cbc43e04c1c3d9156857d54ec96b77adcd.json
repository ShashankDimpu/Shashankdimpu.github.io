{"ast":null,"code":"import{useEffect,useRef,useState}from'react';export function useScrollAnimation(){let threshold=arguments.length>0&&arguments[0]!==undefined?arguments[0]:0.12;const ref=useRef(null);const[inView,setInView]=useState(false);useEffect(()=>{const observer=new IntersectionObserver(_ref=>{let[entry]=_ref;if(entry.isIntersecting){setInView(true);observer.disconnect();}},{threshold});const el=ref.current;if(el)observer.observe(el);return()=>observer.disconnect();},[threshold]);return[ref,inView];}","map":{"version":3,"names":["useEffect","useRef","useState","useScrollAnimation","threshold","arguments","length","undefined","ref","inView","setInView","observer","IntersectionObserver","_ref","entry","isIntersecting","disconnect","el","current","observe"],"sources":["d:/hosting/src/hooks/useScrollAnimation.js"],"sourcesContent":["import { useEffect, useRef, useState } from 'react';\n\nexport function useScrollAnimation(threshold = 0.12) {\n  const ref = useRef(null);\n  const [inView, setInView] = useState(false);\n\n  useEffect(() => {\n    const observer = new IntersectionObserver(\n      ([entry]) => {\n        if (entry.isIntersecting) {\n          setInView(true);\n          observer.disconnect();\n        }\n      },\n      { threshold }\n    );\n    const el = ref.current;\n    if (el) observer.observe(el);\n    return () => observer.disconnect();\n  }, [threshold]);\n\n  return [ref, inView];\n}\n"],"mappings":"AAAA,OAASA,SAAS,CAAEC,MAAM,CAAEC,QAAQ,KAAQ,OAAO,CAEnD,MAAO,SAAS,CAAAC,kBAAkBA,CAAA,CAAmB,IAAlB,CAAAC,SAAS,CAAAC,SAAA,CAAAC,MAAA,IAAAD,SAAA,MAAAE,SAAA,CAAAF,SAAA,IAAG,IAAI,CACjD,KAAM,CAAAG,GAAG,CAAGP,MAAM,CAAC,IAAI,CAAC,CACxB,KAAM,CAACQ,MAAM,CAAEC,SAAS,CAAC,CAAGR,QAAQ,CAAC,KAAK,CAAC,CAE3CF,SAAS,CAAC,IAAM,CACd,KAAM,CAAAW,QAAQ,CAAG,GAAI,CAAAC,oBAAoB,CACvCC,IAAA,EAAa,IAAZ,CAACC,KAAK,CAAC,CAAAD,IAAA,CACN,GAAIC,KAAK,CAACC,cAAc,CAAE,CACxBL,SAAS,CAAC,IAAI,CAAC,CACfC,QAAQ,CAACK,UAAU,CAAC,CAAC,CACvB,CACF,CAAC,CACD,CAAEZ,SAAU,CACd,CAAC,CACD,KAAM,CAAAa,EA